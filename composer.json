{
    "name": "netglue/prismic-doctype-client",
    "type": "library",
    "description": "Prismic Custom Type API Client",
    "keywords": [],
    "homepage": "https://github.com/netglue/prismic-doctype-client",
    "license": "MIT",
    "authors": [
        {
            "name": "George Steel",
            "email": "george@net-glue.co.uk"
        }
    ],
    "require": {
        "php": "~8.2.0 || ~8.3 || ~8.4",
        "ext-json": "*",
        "php-http/discovery": "^1.14.1",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "*",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "webmozart/assert": "^1.10"
    },
    "require-dev": {
        "ext-curl": "*",
        "doctrine/coding-standard": "^14.0",
        "infection/infection": "^0.31.2",
        "laminas/laminas-diactoros": "^3.6.0",
        "php-http/curl-client": "^2.3.3",
        "phpunit/phpunit": "^11.5.42",
        "psalm/plugin-phpunit": "^0.19.5",
        "react/child-process": "^0.6.6",
        "react/http": "^1.11",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^4.0.0",
        "vimeo/psalm": "^6.13.1"
    },
    "conflict": {
        "php-http/httplug": "<2.4.1",
        "shish/safe": "<2.6.4",
        "sanmai/pipeline": "<6.12",
        "symfony/options-resolver": "<7.2",
        "amphp/dns": "<2.1.2",
        "amphp/socket": "<2.3.1"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "infection/extension-installer": true,
            "ergebnis/composer-normalize": true,
            "php-http/discovery": false
        },
        "platform": {
            "php": "8.2.99"
        }
    },
    "extra": {
        "composer-normalize": {
            "indent-size": 4,
            "indent-style": "space"
        }
    },
    "autoload": {
        "psr-4": {
            "Prismic\\DocumentType\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Prismic\\DocumentType\\Test\\Unit\\": "test/Unit",
            "Prismic\\DocumentType\\Test\\Integration\\": "test/Integration",
            "Prismic\\DocumentType\\Test\\Smoke\\": "test/Smoke"
        }
    },
    "scripts": {
        "check": [
            "phpcs",
            "psalm --stats",
            "phpunit",
            "infection --configuration=infection-custom.json"
        ],
        "clean": [
            "composer normalize",
            "psalm --generate-baseline",
            "phpcbf"
        ],
        "static-analysis": "psalm --shepherd "
    }
}
